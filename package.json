{
  "name": "@mnaoumov/typescript-test-toolkit",
  "version": "1.0.3",
  "description": "Generic test support for TypeScript projects: Vitest/Jest setup, async-operation tracking, strictProxy and mock helpers.",
  "keywords": [
    "typescript",
    "testing",
    "vitest",
    "jest"
  ],
  "homepage": "https://mnaoumov.dev/typescript-test-toolkit/",
  "bugs": {
    "url": "https://github.com/mnaoumov/typescript-test-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnaoumov/typescript-test-toolkit.git"
  },
  "license": "MIT",
  "author": "Michael Naumov",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/esm/index.d.mts",
        "default": "./dist/lib/esm/index.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/index.d.cts",
        "default": "./dist/lib/cjs/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/lib/esm/*.d.mts",
        "default": "./dist/lib/esm/*.mjs"
      },
      "require": {
        "types": "./dist/lib/cjs/*.d.cts",
        "default": "./dist/lib/cjs/*.cjs"
      }
    }
  },
  "files": [
    "**/package.json",
    "dist/",
    "!dist/*.tgz",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "jiti scripts/build.ts",
    "build:clean": "jiti scripts/build-clean.ts",
    "build:compile": "jiti scripts/build-compile.ts",
    "build:generate-exports": "jiti scripts/build-generate-exports.ts",
    "build:generate-index": "jiti scripts/build-generate-index.ts",
    "build:lib": "jiti scripts/build-lib.ts",
    "build:types": "jiti scripts/build-types.ts",
    "build:validate-declarations": "jiti scripts/build-validate-declarations.ts",
    "build:validate-dependencies": "jiti scripts/build-validate-dependencies.ts",
    "commit": "jiti scripts/commit.ts",
    "docs:build": "jiti scripts/docs-build.ts",
    "docs:check-snippets": "jiti scripts/docs-check-snippets.ts",
    "docs:dev": "jiti scripts/docs-dev.ts",
    "docs:preview": "jiti scripts/docs-preview.ts",
    "find-overexposed": "jiti scripts/find-overexposed.ts",
    "find-overexposed:fix": "jiti scripts/find-overexposed-fix.ts",
    "format": "jiti scripts/format.ts",
    "format:check": "jiti scripts/format-check.ts",
    "gate": "jiti scripts/gate.ts",
    "lint": "jiti scripts/lint.ts",
    "lint:fix": "jiti scripts/lint-fix.ts",
    "lint:md": "jiti scripts/lint-md.ts",
    "lint:md:fix": "jiti scripts/lint-md-fix.ts",
    "prepare": "jiti scripts/prepare.ts",
    "publish:npm": "jiti scripts/publish-npm.ts",
    "spellcheck": "jiti scripts/spellcheck.ts",
    "test": "jiti scripts/test.ts",
    "test:coverage": "jiti scripts/test-coverage.ts",
    "test:watch": "jiti scripts/test-watch.ts",
    "version": "jiti scripts/version.ts"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.2",
    "@vitest/coverage-v8": "$@vitest/coverage-v8",
    "deepmerge-ts": "^8.0.2",
    "eslint": "$eslint",
    "eslint-plugin-import": "npm:eslint-plugin-import-x@^4.17.1",
    "fflate": "^0.7.5",
    "js-yaml": "4.3.2",
    "katex": "^0.18.2",
    "re2js": "^2.9.1",
    "smol-toml": "^1.8.0",
    "typescript": "$typescript"
  },
  "dependencies": {
    "@mnaoumov/typescript-lib": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/starlight": "^0.42.6",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@jest/globals": "^30.5.2",
    "@mnaoumov/typescript-dev-toolkit": "^5.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "astro": "^7.4.0",
    "better-typescript-lib": "^2.12.0",
    "cspell": "^10.3.3",
    "czg": "^1.14.0",
    "dprint": "^0.57.4",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-tsdoc": "^0.5.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.0",
    "markdownlint-cli2": "^0.24.0",
    "nano-staged": "^1.0.2",
    "satori": "^0.33.5",
    "satteri": "^0.10.5",
    "ts-morph": "^28.0.0",
    "tslib": "^2.8.1",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@jest/globals": "^30.5.2",
    "vitest": "^5.0.1"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
